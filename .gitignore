# Data (datasets are large - don't commit them, document how to get them instead)
# Note: README.md files inside datasets/ ARE committed (not caught by these
# patterns) so the download instructions survive even though the data doesn't.
/ingestion/datasets/**/*.csv
/ingestion/datasets/**/*.zip
/ingestion/ground_truth_log.csv
*.parquet

# Model artifacts (large binary files - track separately if needed)
/ml/models/*.pkl
/ml/models/*.pt
/ml/models/*.h5

# Gateway (private key)
gateway/key.pem
gateway/cert.pem

mkcert.exe
test_payload.json
